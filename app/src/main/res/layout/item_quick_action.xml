<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingTop="18dp" android:paddingBottom="18dp"
        android:paddingStart="8dp" android:paddingEnd="8dp">
        <ImageView android:importantForAccessibility="no" android:id="@+id/qaIcon" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="11dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/qaLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:gravity="center" android:textSize="12.5sp" android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
