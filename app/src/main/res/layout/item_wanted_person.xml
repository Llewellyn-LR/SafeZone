<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:clipChildren="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/armedBanner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@color/coral"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:drawableStart="@drawable/ic_warning" android:drawablePadding="6dp"
            android:drawableTint="@color/white" android:gravity="center_vertical"
            android:text="ARMED AND DANGEROUS — DO NOT APPROACH"
            android:textColor="@color/white" android:textSize="11.5sp" android:textStyle="bold"
            android:letterSpacing="0.026" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/photo"
                    android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@color/background" android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/SafeZone.ShapeAppearance.Photo" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/name" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/lastSeen" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:textSize="12.5sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/wantedFor" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:textSize="13.5sp" android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.15" />
            <TextView android:id="@+id/caseRef" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textSize="11.5sp" android:fontFamily="monospace"
                android:textColor="@color/text_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/callButton"
                style="@style/SafeZone.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Call Crime Stop (anonymous)"
                android:textAllCaps="false"
                app:icon="@drawable/ic_phone_forwarded" app:iconSize="17dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
