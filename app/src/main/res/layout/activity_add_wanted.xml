<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:background="@drawable/bg_rising_hands"  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        style="@style/SafeZone.Toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="Add Wanted Person" app:navigationIcon="?attr/homeAsUpIndicator" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <TextView android:id="@+id/infoBox" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="12dp"
                android:textSize="12.5sp" android:textColor="@color/navy"
                android:lineSpacingMultiplier="1.15"
                android:text="Only enter details sourced from an official SAPS notice. This publishes immediately to every resident, including guests." />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Name (or 'Unknown Male' / 'Unknown Female')">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameField"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="Alias (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/aliasField"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Wanted for" android:accessibilityHeading="true"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/wantedForField"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="3" android:maxLines="3" android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences" android:textSize="14sp"
                    android:hint="What this person is wanted for, from the SAPS notice" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="Last seen area">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/areaField"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="SAPS case reference (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/caseRefField"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Armed and dangerous" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Shows a prominent warning banner on the listing"
                        android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/armedSwitch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:theme="@style/SafeZone.Switch.Coral" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView android:id="@+id/attachButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="10dp" android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent" app:cardElevation="0dp"
                app:cardCornerRadius="14dp" app:strokeColor="@color/outline_grey" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center">
                    <FrameLayout android:layout_width="24dp" android:layout_height="24dp">
                        <ImageView android:importantForAccessibility="no" android:id="@+id/attachIcon" android:layout_width="24dp"
                            android:layout_height="24dp" android:src="@drawable/ic_camera_alt"
                            android:tint="@color/text_primary" />
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/attachSpinner" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="center"
                            android:indeterminate="true" android:visibility="gone"
                            app:indicatorSize="16dp" app:trackThickness="2dp"
                            app:indicatorColor="@color/navy" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="Attach a photo (optional)"
                        android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/attachedCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:visibility="gone"
                app:cardBackgroundColor="@color/white" app:cardElevation="0dp"
                app:cardCornerRadius="14dp" app:strokeColor="@color/green" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="10dp">
                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/thumb"
                        android:layout_width="48dp" android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/SafeZone.ShapeAppearance.Photo" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Photo attached" android:textStyle="bold"
                        android:textColor="@color/green_text" />
                    <ImageView android:id="@+id/removePhoto" android:layout_width="48dp"
                        android:layout_height="48dp" android:padding="12dp"
                        android:src="@drawable/ic_close" android:tint="@color/text_secondary"
                        android:contentDescription="Remove photo" android:tooltipText="Remove photo"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/errorText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="@color/coral_text" android:textSize="13sp" android:visibility="gone" />

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/publishButton"
                    style="@style/SafeZone.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Publish" />
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/publishSpinner" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:indeterminate="true" android:visibility="gone"
                    app:indicatorSize="22dp" app:trackThickness="2dp"
                    app:indicatorColor="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
