<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/bg_rising_hands">
        <FrameLayout android:id="@+id/tabReports" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <FrameLayout android:id="@+id/tabWanted" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" />
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/adminNav" style="@style/SafeZone.BottomNav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:menu="@menu/menu_admin_bottom" />
</LinearLayout>
