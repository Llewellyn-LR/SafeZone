<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        style="@style/SafeZone.Toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" app:title="Alerts" app:menu="@menu/menu_alerts" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="4dp" android:clipToPadding="false">
        <LinearLayout android:id="@+id/chipRow" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <TextView android:id="@+id/radiusNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="4dp" android:textSize="12.5sp" android:textColor="@color/text_secondary" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <com.safezone.app.ui.anim.HandsLoaderView android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"  android:contentDescription="Loading" />
        <com.safezone.app.ui.common.StreamErrorView android:id="@+id/errorView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center_horizontal"
            android:paddingTop="120dp" android:visibility="gone"
            android:text="No alerts in this category right now."
            android:textColor="@color/text_secondary" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:visibility="gone" android:padding="16dp"
            android:paddingBottom="6dp" />
    </FrameLayout>
</LinearLayout>
