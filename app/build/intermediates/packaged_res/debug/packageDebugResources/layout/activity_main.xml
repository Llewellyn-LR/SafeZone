<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout android:id="@+id/container"
        android:background="@drawable/bg_sunset_bay"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav"
        style="@style/SafeZone.BottomNav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:menu="@menu/menu_home_bottom" xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
