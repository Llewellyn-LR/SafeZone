<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:background="@drawable/bg_sunset_bay" 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
            style="@style/SafeZone.Toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:title="Wanted Persons" app:navigationIcon="?attr/homeAsUpIndicator" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <com.safezone.app.ui.anim.HandsLoaderView android:id="@+id/progress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"  android:contentDescription="Loading" />
            <com.safezone.app.ui.common.StreamErrorView android:id="@+id/errorView"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone" />
            <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
                android:layout_height="match_parent" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:id="@+id/infoBanner" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:padding="14dp">
                        <ImageView android:importantForAccessibility="no" android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_info" android:tint="@color/navy" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="10dp"
                            android:textSize="12.5sp" android:textColor="@color/navy"
                            android:lineSpacingMultiplier="1.15"
                            android:text="For information only. Do not approach anyone listed — call Crime Stop anonymously, or 10111 in an emergency. These notices come only from SAPS." />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/list" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
